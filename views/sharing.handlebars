    <title>Nordbase Remote</title>
    <style>
        :root {
            --nordbase-bg: #070807;
            --nordbase-panel: rgba(16, 18, 15, 0.92);
            --nordbase-panel-solid: #10120f;
            --nordbase-line: rgba(246, 244, 238, 0.13);
            --nordbase-text: #f6f4ee;
            --nordbase-muted: rgba(246, 244, 238, 0.64);
            --nordbase-subtle: rgba(246, 244, 238, 0.08);
            --nordbase-accent: #9ff0bd;
            --nordbase-danger: #ff6b6b;
        }
        html, body {
            margin: 0;
            min-height: 100%;
            font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            letter-spacing: 0;
        }
        body.rmm-remote {
            background: var(--nordbase-bg) !important;
            color: var(--nordbase-text);
        }
        body.rmm-remote .areaHead,
        body.rmm-remote .areaFoot,
        body.rmm-remote .areaHead2,
        body.rmm-remote .areaHead3 {
            background: var(--nordbase-panel) !important;
            color: var(--nordbase-text) !important;
            border: 0 !important;
            box-shadow: none !important;
        }
        body.rmm-remote #deskarea1,
        body.rmm-remote #deskarea4 {
            position: relative;
            z-index: 5;
            height: 44px !important;
            min-height: 44px !important;
            line-height: 44px !important;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 12px;
            box-sizing: border-box;
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
        }
        body.rmm-remote #deskarea1 {
            border-bottom: 1px solid var(--nordbase-line) !important;
        }
        body.rmm-remote #deskarea4 {
            border-top: 1px solid var(--nordbase-line) !important;
        }
        body.rmm-remote #deskarea1 > div,
        body.rmm-remote #deskarea4 > div {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            height: 100%;
        }
        body.rmm-remote #deskarea1 .toright2,
        body.rmm-remote #deskarea4 .toright2 {
            order: 2;
            margin-left: auto;
            float: none !important;
        }
        body.rmm-remote input,
        body.rmm-remote select {
            min-height: 30px;
            border: 1px solid var(--nordbase-line) !important;
            border-radius: 6px !important;
            background: rgba(246, 244, 238, 0.08) !important;
            color: var(--nordbase-text) !important;
            font: inherit;
            font-size: 12px;
            line-height: 1;
            transition: background .16s ease, border-color .16s ease, transform .16s ease;
        }
        body.rmm-remote input[type=button] {
            padding: 0 10px;
            cursor: pointer;
        }
        body.rmm-remote input[type=button]:hover {
            background: rgba(246, 244, 238, 0.13) !important;
            border-color: rgba(246, 244, 238, 0.24) !important;
        }
        body.rmm-remote input[type=button]:active {
            transform: translateY(1px);
        }
        body.rmm-remote #DeskClip {
            display: inline-flex !important;
            align-items: center;
            font-weight: 650;
        }
        body.rmm-remote #connectbutton1span,
        body.rmm-remote #connectbutton1hspan,
        body.rmm-remote #connectbutton2span,
        body.rmm-remote #p13Connect,
        body.rmm-remote .deskareaicon,
        body.rmm-remote #idx_deskFullBtn2,
        body.rmm-remote #DeskLatency,
        body.rmm-remote #termdisplays,
        body.rmm-remote #DeskWD,
        body.rmm-remote #deskkeys,
        body.rmm-remote #DeskSaveImageButton {
            display: none !important;
        }
        body.rmm-remote #disconnectbutton1,
        body.rmm-remote #disconnectbutton2 {
            min-width: 104px;
            height: 32px;
            border-color: rgba(255, 107, 107, 0.32) !important;
            background: rgba(255, 107, 107, 0.12) !important;
            color: #ffdede !important;
            font-weight: 650;
        }
        body.rmm-remote #disconnectbutton1:hover,
        body.rmm-remote #disconnectbutton2:hover {
            background: rgba(255, 107, 107, 0.2) !important;
            border-color: rgba(255, 107, 107, 0.48) !important;
        }
        body.rmm-remote #deskActionsSettings {
            height: 32px;
            min-width: 124px;
            font-size: 12px;
            padding: 0 10px;
            background: rgba(246, 244, 238, 0.08) !important;
        }
        body.rmm-remote #deskstatus,
        body.rmm-remote #termstatus,
        body.rmm-remote #p13Status {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: var(--nordbase-accent) !important;
            font-weight: 700;
            font-size: 12px;
            line-height: 1;
            padding: 7px 10px;
            border: 1px solid rgba(159, 240, 189, 0.22);
            border-radius: 999px;
            background: rgba(159, 240, 189, 0.1);
        }
        body.rmm-remote #deskstatus::before {
            content: "";
            width: 7px;
            height: 7px;
            border-radius: 999px;
            background: currentColor;
            box-shadow: 0 0 0 4px rgba(159, 240, 189, 0.12);
        }
        body.rmm-remote #deskarea3x {
            max-height: calc(100vh - 88px) !important;
            height: calc(100vh - 88px) !important;
            background: #050605;
        }
        body.rmm-remote #rmmRemoteBadge {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            margin-left: 0;
            color: var(--nordbase-text);
            font-weight: 700;
            font-size: 13px;
            line-height: 1;
            white-space: nowrap;
        }
        body.rmm-remote #rmmRemoteBadge::before {
            content: "B";
            display: inline-grid;
            place-items: center;
            width: 24px;
            height: 24px;
            border-radius: 6px;
            background: var(--nordbase-text);
            color: #080a08;
            font-weight: 850;
        }
        body.rmm-remote #rmmRemoteBadge span {
            color: var(--nordbase-muted);
            font-weight: 500;
            max-width: 34vw;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        body.rmm-remote #p11power,
        body.rmm-remote #DeskTimer {
            display: inline-flex !important;
            align-items: center;
            min-height: 28px;
            width: auto !important;
            padding: 0 10px;
            border: 1px solid var(--nordbase-line);
            border-radius: 999px;
            background: rgba(246, 244, 238, 0.06);
            color: var(--nordbase-muted);
            font-size: 12px;
            line-height: 1;
        }
        body.rmm-remote #DeskTimer:empty,
        body.rmm-remote #DeskLatency:empty {
            display: none !important;
        }
        body.rmm-remote #DeskControlSpan {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            min-height: 28px;
            padding: 0 10px;
            border-radius: 999px;
            background: rgba(246, 244, 238, 0.06);
            color: var(--nordbase-muted);
            font-size: 12px;
        }
        body.rmm-remote #DeskControlSpan input {
            min-height: auto;
            margin: 0;
            accent-color: var(--nordbase-accent);
        }
        body.rmm-remote #idx_deskFullBtn2 {
            width: 30px;
            height: 30px;
            display: inline-grid;
            place-items: center;
            border-radius: 6px;
            background: rgba(246, 244, 238, 0.08);
            color: var(--nordbase-muted);
            cursor: pointer;
            float: none !important;
            margin: 0 !important;
            transition: background .16s ease, color .16s ease;
        }
        body.rmm-remote #idx_deskFullBtn2:hover {
            background: rgba(246, 244, 238, 0.14);
            color: var(--nordbase-text);
        }
        body.rmm-remote #dialog {
            position: fixed !important;
            left: 50% !important;
            top: 50% !important;
            width: min(520px, calc(100vw - 32px)) !important;
            max-height: min(720px, calc(100vh - 32px));
            transform: translate(-50%, -50%);
            border: 1px solid var(--nordbase-line);
            border-radius: 8px;
            background: rgba(18, 20, 17, 0.98);
            color: var(--nordbase-text);
            box-shadow: 0 24px 80px rgba(0, 0, 0, 0.45);
            overflow: hidden;
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
        }
        body.rmm-remote #dialogHeader {
            height: 48px;
            display: flex;
            align-items: center;
            border-bottom: 1px solid var(--nordbase-line);
            background: rgba(246, 244, 238, 0.04);
            padding: 0 12px 0 16px;
            box-sizing: border-box;
        }
        body.rmm-remote #id_dialogtitle {
            color: var(--nordbase-text);
            font-size: 14px;
            font-weight: 750;
        }
        body.rmm-remote #id_dialogclose {
            order: 2;
            margin-left: auto;
            width: 30px;
            height: 30px;
            display: grid;
            place-items: center;
            border-radius: 6px;
            color: var(--nordbase-muted);
            cursor: pointer;
        }
        body.rmm-remote #id_dialogclose:hover {
            background: rgba(246, 244, 238, 0.08);
            color: var(--nordbase-text);
        }
        body.rmm-remote #dialogBody {
            padding: 16px;
            color: var(--nordbase-text);
            box-sizing: border-box;
            max-height: calc(100vh - 150px);
            overflow: auto;
        }
        body.rmm-remote #dialog7 h4 {
            margin: 0 0 12px;
            color: var(--nordbase-text);
            font-size: 12px;
            font-weight: 750;
            text-transform: uppercase;
            letter-spacing: .06em;
        }
        body.rmm-remote #dialog7 > div > div {
            display: grid;
            grid-template-columns: 140px 1fr;
            align-items: center;
            gap: 12px;
            min-height: 42px;
            border-top: 1px solid rgba(246, 244, 238, 0.08);
        }
        body.rmm-remote #dialog7 > div > div > div:first-child {
            color: var(--nordbase-muted);
            font-size: 12px;
        }
        body.rmm-remote #dialog7 label {
            color: var(--nordbase-muted);
            font-size: 12px;
            line-height: 1.8;
        }
        body.rmm-remote #dialog7 input[type=checkbox] {
            min-height: auto;
            margin-right: 8px;
            accent-color: var(--nordbase-accent);
        }
        body.rmm-remote #dialog7 select {
            width: 100%;
            height: 34px;
        }
        body.rmm-remote #dialog7 option {
            background: #10120f;
            color: var(--nordbase-text);
        }
        body.rmm-remote #dialog7 #d7desktopOtherSettings {
            margin-top: 10px;
        }
        body.rmm-remote #dialog7 #d7otherset2 {
            padding: 8px 0;
        }
        body.rmm-remote #idx_dlgButtonBar {
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            padding: 12px 16px;
            border-top: 1px solid var(--nordbase-line);
            background: rgba(0, 0, 0, 0.16);
        }
        body.rmm-remote #idx_dlgButtonBar input {
            min-width: 84px;
        }
        body.rmm-remote #idx_dlgOkButton {
            background: var(--nordbase-accent) !important;
            border-color: var(--nordbase-accent) !important;
            color: #071008 !important;
            font-weight: 750;
        }

        /* Nordbase Remote step 1 (2026-11-15): larger touch-friendly controls, quality, screens,
           quick keys, connection indicator and the reconnect overlay. */
        body.rmm-remote #deskarea1,
        body.rmm-remote #deskarea4 {
            height: 52px !important;
            min-height: 52px !important;
            line-height: normal !important;
            gap: 8px;
        }
        body.rmm-remote #deskarea1 > div,
        body.rmm-remote #deskarea4 > div {
            flex: 0 0 auto;
        }
        body.rmm-remote #deskstatus,
        body.rmm-remote #p11power { white-space: nowrap; }
        body.rmm-remote #rmmRemoteBadge span { max-width: 18vw !important; }
        body.rmm-remote .rmm-icon { width: 44px; padding: 0 !important; }
        body.rmm-remote #deskarea3x {
            position: relative;
            height: calc(100vh - 104px) !important;
            max-height: calc(100vh - 104px) !important;
        }
        body.rmm-remote #DeskParent {
            height: 100%;
            text-align: center;
        }
        body.rmm-remote .rmm-btn,
        body.rmm-remote #DeskType,
        body.rmm-remote #DeskClip,
        body.rmm-remote #deskActionsSettings,
        body.rmm-remote #disconnectbutton1 {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            height: 40px !important;
            min-height: 40px !important;
            min-width: 44px;
            padding: 0 10px !important;
            border: 1px solid var(--nordbase-line) !important;
            border-radius: 8px !important;
            background: rgba(246, 244, 238, 0.08) !important;
            color: var(--nordbase-text) !important;
            font: inherit;
            font-size: 14px !important;
            font-weight: 600;
            line-height: 1;
            white-space: nowrap;
            cursor: pointer;
            flex: 0 0 auto;
            -webkit-tap-highlight-color: transparent;
            touch-action: manipulation;
        }
        body.rmm-remote .rmm-btn:hover { background: rgba(246, 244, 238, 0.14) !important; }
        body.rmm-remote .rmm-btn:active { transform: translateY(1px); }
        body.rmm-remote .rmm-btn:disabled,
        body.rmm-remote #DeskType:disabled,
        body.rmm-remote #DeskClip:disabled { opacity: .45; cursor: default; }
        body.rmm-remote #disconnectbutton1 {
            border-color: rgba(255, 107, 107, 0.36) !important;
            background: rgba(255, 107, 107, 0.14) !important;
            color: #ffdede !important;
        }
        body.rmm-remote .rmm-seg {
            display: inline-flex;
            flex: 0 0 auto;
            padding: 3px;
            gap: 2px;
            border: 1px solid var(--nordbase-line);
            border-radius: 10px;
            background: rgba(0, 0, 0, 0.25);
        }
        body.rmm-remote .rmm-seg .rmm-btn {
            height: 34px !important;
            min-height: 34px !important;
            border-color: transparent !important;
            background: transparent !important;
            color: var(--nordbase-muted) !important;
        }
        body.rmm-remote .rmm-seg .rmm-btn[aria-pressed="true"] {
            background: var(--nordbase-text) !important;
            color: #080a08 !important;
        }
        body.rmm-remote .rmm-toggle[aria-pressed="true"] {
            border-color: rgba(159, 240, 189, 0.45) !important;
            background: rgba(159, 240, 189, 0.14) !important;
            color: var(--nordbase-accent) !important;
        }
        body.rmm-remote .rmm-net {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            height: 32px;
            padding: 0 12px;
            border-radius: 999px;
            border: 1px solid var(--nordbase-line);
            background: rgba(246, 244, 238, 0.06);
            color: var(--nordbase-text);
            font-size: 13px;
            font-weight: 600;
            white-space: nowrap;
            flex: 0 0 auto;
        }
        body.rmm-remote .rmm-net i {
            width: 10px;
            height: 10px;
            border-radius: 999px;
            background: #8b8f88;
        }
        body.rmm-remote .rmm-net small { color: var(--nordbase-muted); font-size: 12px; font-weight: 500; }
        body.rmm-remote .rmm-net.rmm-net-good i { background: #5fd68a; }
        body.rmm-remote .rmm-net.rmm-net-shaky i { background: #f2c94c; }
        body.rmm-remote .rmm-net.rmm-net-bad i { background: #ff6b6b; }
        body.rmm-remote #deskarea4 > .rmm-keys {
            flex: 1 1 auto;
            min-width: 0;
            overflow-x: auto;
            overflow-y: hidden;
            scrollbar-width: none;
            -webkit-overflow-scrolling: touch;
        }
        body.rmm-remote .rmm-keys::-webkit-scrollbar { display: none; }
        body.rmm-remote .rmm-sep {
            width: 1px;
            height: 24px;
            background: var(--nordbase-line);
            flex: 0 0 auto;
        }
        body.rmm-remote #deskarea4 .toright2 { flex: 0 0 auto; }
        body.rmm-remote #DeskControlSpan { height: 40px; min-height: 40px !important; font-size: 14px !important; white-space: nowrap; }
        body.rmm-remote #rmmReconnect {
            position: absolute;
            inset: 0;
            z-index: 4;
            display: none;
            align-items: center;
            justify-content: center;
            background: rgba(5, 6, 5, 0.45);
            pointer-events: none;
        }
        body.rmm-remote #rmmReconnect.rmm-show { display: flex; }
        body.rmm-remote #rmmReconnect > div {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            max-width: calc(100% - 32px);
            padding: 20px 28px;
            border: 1px solid var(--nordbase-line);
            border-radius: 12px;
            background: rgba(16, 18, 15, 0.94);
            color: var(--nordbase-text);
            text-align: center;
            pointer-events: auto;
        }
        body.rmm-remote #rmmReconnectTitle { font-size: 18px; font-weight: 700; }
        body.rmm-remote #rmmReconnectText { font-size: 14px; color: var(--nordbase-muted); }
        body.rmm-remote #rmmReconnect .rmm-spin {
            width: 26px;
            height: 26px;
            border-radius: 999px;
            border: 3px solid rgba(246, 244, 238, 0.18);
            border-top-color: var(--nordbase-accent);
            animation: rmmspin 0.9s linear infinite;
        }
        body.rmm-remote #rmmReconnect.rmm-ended .rmm-spin { display: none; }
        body.rmm-remote #rmmReconnect #rmmReconnectButton { display: none; margin-top: 4px; }
        body.rmm-remote #rmmReconnect.rmm-can-retry #rmmReconnectButton { display: inline-flex; }
        body.rmm-remote #Desk.rmm-stale { filter: grayscale(0.85) brightness(0.6); }
        @keyframes rmmspin { to { transform: rotate(360deg); } }
        @media (prefers-reduced-motion: reduce) { body.rmm-remote #rmmReconnect .rmm-spin { animation: none; } }
        body.rmm-remote #dialog7 .rmm-hide { display: none !important; }
        body.rmm-remote #d2typeText,
        body.rmm-remote #d2clipText {
            box-sizing: border-box;
            font-size: 15px !important;
            line-height: 1.4 !important;
            padding: 10px !important;
        }
        /* Narrow windows: hide less important parts, let rows scroll instead of the page. */
        @media (max-width: 1500px) {
            body.rmm-remote #DeskTimer { display: none !important; }
        }
        @media (max-width: 1400px) {
            body.rmm-remote #p11power { display: none !important; }
        }
        @media (max-width: 900px) {
            /* Until the mobile view (step 2): both bars scroll sideways, the page itself never does. */
            body.rmm-remote #rmmRemoteBadge span,
            body.rmm-remote #deskmetadata { display: none !important; }
            body.rmm-remote #deskarea1,
            body.rmm-remote #deskarea4 { overflow-x: auto; overflow-y: hidden; scrollbar-width: none; justify-content: flex-start !important; }
            body.rmm-remote #deskarea1::-webkit-scrollbar,
