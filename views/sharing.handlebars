                if (!pair && !tb) return null;
                return { n: tb + tp + (pair ? ((pair.bytesReceived || 0) + (pair.packetsReceived || 0) + (pair.responsesReceived || 0)) : 0), ts: pair ? (pair.lastPacketReceivedTimestamp || 0) : 0 };
            }).catch(function () { return null; });
        }
        // Called by rmmRtcSend when a special key's bytes are queued or the path broke under them.
        function rmmSpecialNote() {
            if (!rmmSpecialNow) return;
            if (rmmRtc.queueSpecial.indexOf(rmmSpecialNow) < 0) { rmmRtc.queueSpecial.push(rmmSpecialNow); }
            if (!rmmRtc.switching) { rmmSpecialPend(rmmSpecialNow); }       // the channel was closed: send it on the next session
        }
        function rmmSpecialPend(key) { if (rmmSpecialPending.indexOf(key) < 0) { rmmSpecialPending.push(key); rmmStats.specialKept = (rmmStats.specialKept || 0) + 1; } }
        function rmmSpecialSessionReady() {
            if (!rmmSpecialWait) return;
            rmmSpecialWait = false;
            setTimeout(rmmSpecialFlush, 250); // the agent's KVM is running once it has sent its screen size
        }
        function rmmSpecialFlush() {
            var now = Date.now(), list = rmmSpecialPending;
            rmmSpecialPending = [];
            if ((desktop == null) || (desktop.State != 3) || !rmmDesktopReconnectEnabled || shareIsExpired()) return;
            for (var i = 0; i < list.length; i++) {
                if ((now - list[i].at) > 10000) continue; // too old: a late Ctrl+Alt+Del would surprise
                rmmStats.specialResent = (rmmStats.specialResent || 0) + 1;
                rmmSpecialKey(list[i].label, list[i].fn, list[i]);
            }
        }

        start();
    </script>
