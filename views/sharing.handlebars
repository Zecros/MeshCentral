            if ((code == 'AltLeft') || (code == 'AltRight')) { st.alt = true; return true; }
            if (e.metaKey || st.cmd) {
                if (rmmIsModifier(code)) return false;
                kc = rmmVk(code);
                if (kc == null) return true;
                if (!st.ctrlSent) { desktop.m.SendKeyMsgKC(A.DOWN, 17); st.ctrlSent = true; }
                if ((e.altKey || st.alt) && !st.altSent) { desktop.m.SendKeyMsgKC(A.DOWN, 18); st.altSent = true; }
                // macOS sends no keyup for a key pressed while Cmd is held, so press and release now.
                rmmSendVk(A.DOWN, code, kc); rmmSendVk(A.UP, code, kc);
                st.swallowPress = true;
                return true;
            }
            if (e.altKey || st.alt) {
                if (!e.ctrlKey && (typeof e.key == 'string') && (e.key.length == 1) && (RMM_ALTGR_CHARS.indexOf(e.key) >= 0)) {
                    desktop.m.SendKeyUnicode(A.DOWN, e.key.charCodeAt(0)); desktop.m.SendKeyUnicode(A.UP, e.key.charCodeAt(0));
                    st.handled[code] = 0; st.swallowPress = true;
                    return true;
                }
                if (e.key == 'Dead') { st.handled[code] = 0; return true; } // the next key types the accent or ~
                if (rmmIsModifier(code)) return false;
                kc = rmmVk(code);
                if (kc == null) return true;
                if (!st.altSent) { desktop.m.SendKeyMsgKC(A.DOWN, 18); st.altSent = true; }
                rmmSendVk(A.DOWN, code, kc);
                st.handled[code] = kc; st.swallowPress = true;
                return true;
            }
            if ((code == 'IntlBackslash') && (e.ctrlKey || !((typeof e.key == 'string') && (e.key.length == 1)))) {
                rmmSendVk(A.DOWN, code, 226); st.handled[code] = 226;
                return true;
            }
            return false;
        }

        function rmmKeyUp(e) {
            if (!rmmKeyActive()) return false;
            var code = e.code || '', A = desktop.m.KeyAction, st = rmmKeyState;
            if ((code == 'MetaLeft') || (code == 'MetaRight')) {
                st.cmd = false;
                if (st.ctrlSent) { desktop.m.SendKeyMsgKC(A.UP, 17); st.ctrlSent = false; }
                if (st.altSent && !st.alt) { desktop.m.SendKeyMsgKC(A.UP, 18); st.altSent = false; }
                return true;
            }
            if ((code == 'AltLeft') || (code == 'AltRight')) {
                st.alt = false;
                if (st.altSent && !st.ctrlSent) { desktop.m.SendKeyMsgKC(A.UP, 18); st.altSent = false; }
                return true;
            }
            if (st.handled.hasOwnProperty(code)) { var kc = st.handled[code]; delete st.handled[code]; if (kc) { rmmSendVk(A.UP, code, kc); } return true; }
            if ((e.metaKey || st.cmd) && !rmmIsModifier(code)) return true; // already pressed and released
            return false;
        }

        function rmmKeyPress(e) {
            if (!rmmKeyActive()) return false;
            if (rmmKeyState.swallowPress) { rmmKeyState.swallowPress = false; return true; }
            if (e.metaKey || rmmKeyState.cmd) return true;
            return false;
        }

        // The window lost focus: release what is held on the remote computer, so no key gets stuck.
        function rmmReleaseModifiers() {
            var st = rmmKeyState;
            if ((desktop != null) && (desktop.State == 3) && (desktop.contype == 1) && desktop.m) {
                var A = desktop.m.KeyAction;
                if (st.ctrlSent) { desktop.m.SendKeyMsgKC(A.UP, 17); }
                if (st.altSent) { desktop.m.SendKeyMsgKC(A.UP, 18); }
                for (var c in st.handled) { if (st.handled[c]) { rmmSendVk(A.UP, c, st.handled[c]); } }
                if (desktop.m.handleReleaseKeys) { desktop.m.handleReleaseKeys(); }
            }
            rmmKeyState = { cmd: false, ctrlSent: false, alt: false, altSent: false, handled: {}, swallowPress: false };
        }

        function rmmToggleMacKeys() {
            rmmReleaseModifiers();
            rmmPrefs.macKeys = !rmmMacKeysOn();
            rmmSavePrefs();
            rmmUpdateUi();
        }

        function rmmFillSettings() {
            if (Q('d7rmmMacKeys')) { Q('d7rmmMacKeys').checked = rmmMacKeysOn(); }
            QH('d7rmmInfo', EscapeHtml(rmmInfoText()));
            if (Q('d7rmmDirect')) { Q('d7rmmDirect').checked = (rmmPrefs.direct !== false); Q('d7rmmDirect').disabled = !rmmRtcAllowed; QH('d7rmmDirectInfo', EscapeHtml(rmmRtcInfoText())); }
        }

        function rmmReadSettings() {
            if (Q('d7rmmMacKeys') && (Q('d7rmmMacKeys').checked != rmmMacKeysOn())) { rmmReleaseModifiers(); rmmPrefs.macKeys = Q('d7rmmMacKeys').checked; }
            if (Q('d7rmmDirect') && rmmRtcAllowed) { rmmPrefs.direct = Q('d7rmmDirect').checked; if (!rmmPrefs.direct) { rmmRtcStop('turned-off'); } }
            rmmSavePrefs();
            rmmUpdateUi();
        }

        //
        // Connection: indicator, Auto, dead link, reconnect
        //

        function rmmOnDesktopUp() {
            var now = Date.now();
            rmmNet.connectedAt = now; rmmNet.lastReply = 0; rmmNet.lastProbe = 0; rmmNet.lastData = now; rmmNet.rtts = [];
            rmmNet.rateAt = now; rmmNet.bytes = 0; rmmNet.tiles = 0; rmmNet.goodSince = 0; rmmNet.badTicks = rmmNet.shakyTicks = 0;
            rmmNet.state = 'measuring';
            rmmNet.settleUntil = now + 3000; // step 2: the first whole picture is a burst, not a measurement
            if (rmmProbeTimer != null) { clearInterval(rmmProbeTimer); }
            rmmProbeTimer = setInterval(rmmProbe, RMM_PROBE_MS);
            if (rmmTickTimer == null) { rmmTickTimer = setInterval(rmmTick, 1000); }
            setTimeout(rmmProbe, 300);
            if (Q('rmmReconnect').classList.contains('rmm-show')) { rmmShowReconnect('waiting'); }
            rmmApplyProfile('connected');
            rmm2OnDesktopUp();
            rmmUpdateNet();
        }

        function rmmOnDesktopDown() {
            if (rmmProbeTimer != null) { clearInterval(rmmProbeTimer); rmmProbeTimer = null; }
            rmmKeyState = { cmd: false, ctrlSent: false, alt: false, altSent: false, handled: {}, swallowPress: false };
            deskPreferedStickyDisplay = -1; // the remembered screen is restored by rmmRenderDisplays
            rmmNet.state = 'off'; rmmNet.rtts = []; rmmNet.eff = null;
            QV('rmmDisplays', false); // shown again when the agent lists its screens
            rmm2OnDesktopDown();
            rmmUpdateNet();
            if (shareIsExpired()) { rmmShowReconnect('expired'); return; }
            if (!rmmDesktopReconnectEnabled) { rmmSpecialPending = []; rmmShowReconnect('ended'); return; }
            // scheduleDesktopReconnect() shows "Ansluter igen…"
        }

        function rmmOnShareExpired() {
            rmmDesktopReconnectEnabled = false;
            if (typeof rmmSpecialPending != 'undefined') { rmmSpecialPending = []; }
            if (rmmDesktopReconnectTimer != null) { clearTimeout(rmmDesktopReconnectTimer); rmmDesktopReconnectTimer = null; }
            if (desktop != null) { try { desktop.Stop(); } catch (ex) { } }
            rmmShowReconnect('expired');
        }

        function rmmManualReconnect() {
            if (shareIsExpired() || (desktop != null)) return;
            rmmDesktopReconnectEnabled = true;
            rmmReconnectAttempt = 0;
            connectDesktop(null, 1);
        }

        function rmmShowReconnect(kind, delay) {
            var o = Q('rmmReconnect');
            if (!o) return;
            if (((kind == 'retry') || (kind == 'connecting') || (kind == 'waiting')) && rmmQuietNow()) { rmmQuietDefer(kind, delay); return; } // step 2: silent switch to the relay
            o.classList.add('rmm-show');
            o.classList.toggle('rmm-ended', (kind == 'ended') || (kind == 'expired'));
            o.classList.toggle('rmm-can-retry', kind == 'ended');
            if (kind == 'retry') {
                QH('rmmReconnectTitle', rmmHadPicture ? 'Ansluter igen…' : 'Ansluter…');
                QH('rmmReconnectText', (rmmReconnectAttempt > 1) ? format('Försök {0}. Nästa om {1} s.', rmmReconnectAttempt, Math.max(1, Math.round((delay || 0) / 1000))) : 'Bilden kommer tillbaka av sig själv.');
                QH('deskstatus', 'Ansluter igen');
            } else if (kind == 'connecting') {
                QH('rmmReconnectTitle', rmmHadPicture ? 'Ansluter igen…' : 'Ansluter…');
                QH('rmmReconnectText', '');
            } else if (kind == 'waiting') {
                QH('rmmReconnectTitle', 'Ansluten');
                QH('rmmReconnectText', 'Väntar på bilden…');
            } else if (kind == 'ended') {
                QH('rmmReconnectTitle', 'Sessionen är avslutad');
                QH('deskstatus', 'Avslutad');
                QH('rmmReconnectText', 'Inget skickas till datorn nu.');
            } else if (kind == 'expired') {
                QH('rmmReconnectTitle', 'Tiden för fjärrstyrningen är slut');
                QH('deskstatus', 'Slut');
                QH('rmmReconnectText', 'Starta en ny fjärrsession i Control.');
            }
        }

        function rmmHideReconnect() { var o = Q('rmmReconnect'); if (o) { o.classList.remove('rmm-show'); o.classList.remove('rmm-ended'); o.classList.remove('rmm-can-retry'); } }

        function rmmTakeSnapshot(m) {
            rmmSnapshot = null;
            try {
                var c = m.CanvasId;
                if (!rmmHadPicture || !c || !c.width || !c.height) return;
                var s = document.createElement('canvas');
                s.width = c.width; s.height = c.height;
                s.getContext('2d').drawImage(c, 0, 0);
                rmmSnapshot = s;
            } catch (ex) { rmmSnapshot = null; }
        }

        // Keep the last picture (greyed) under "Ansluter igen…" instead of a black screen.
        function rmmRestoreSnapshot(m) {
            if (rmmSnapshot == null) return;
            try {
                var c = m.CanvasId;
                if ((c.width == rmmSnapshot.width) && (c.height == rmmSnapshot.height)) {
                    var ctx = c.getContext('2d');
                    ctx.setTransform(1, 0, 0, 1, 0, 0);
                    ctx.drawImage(rmmSnapshot, 0, 0);
                }
            } catch (ex) { }
            rmmStale = true;
            if (!rmmQuietNow()) { Q('Desk').classList.add('rmm-stale'); }
        }

        function rmmProbe() {
            if ((desktop == null) || (desktop.State != 3) || (desktop.contype != 1)) return;
            var now = Date.now();
            if (rmmNet.lastProbe > rmmNet.lastReply) return; // one probe at a time; its age is the measurement (TCP does not lose the answer)
            rmmNet.lastProbe = now;
            try { desktop.sendCtrlMsg(JSON.stringify({ ctrlChannel: 102938, type: 'rtt', time: now })); } catch (ex) { }
        }

        function rmmOnRtt(ms) {
            var now = Date.now();
            rmmNet.lastReply = now;
            // Step 2: the answer to a probe that waited out a stall says nothing about a queue; leave it out.
            if (rmmNet.stallProbe && (typeof ms == 'number') && ((now - ms) <= (rmmNet.stallProbe + 5))) { rmmNet.stallProbe = 0; return; }
            if ((typeof ms == 'number') && (ms >= 0)) {
                rmmNet.rtts.push({ ms: ms, t: now });
                while (rmmNet.rtts.length > 30) { rmmNet.rtts.shift(); }
            }
        }

        function rmmRecentRtt(now) {
            var v = [];
            for (var i = 0; i < rmmNet.rtts.length; i++) { if ((now - rmmNet.rtts[i].t) < 7000) { v.push(rmmNet.rtts[i].ms); } }
            if (v.length == 0) return null;
            v.sort(function (a, b) { return a - b; });
            return v[Math.floor(v.length / 2)];
        }

        // The line's own normal delay: the lowest answer in the last 30 s. Step 2: with 6 answers or more,
        // the 20th percentile instead, so a jittery mobile line (answers spread 40-300 ms) is not read as a queue.
        var rmmBaseMode = 'p20';
        function rmmBaseRtt(now) {
            var v = [];
            for (var i = 0; i < rmmNet.rtts.length; i++) { if ((now - rmmNet.rtts[i].t) < 30000) { v.push(rmmNet.rtts[i].ms); } }
            if (v.length == 0) return null;
            v.sort(function (a, b) { return a - b; });
            if ((rmmBaseMode != 'p20') || (v.length < 6)) return v[0];
            return v[Math.floor((v.length - 1) * 0.2)];
        }

        // Runs every second while connected. See docs/fjarrstyrning.md for the rules.
        function rmmTick() {
            var now = Date.now();
            if ((desktop == null) || (desktop.State != 3) || (desktop.contype != 1)) {
                rmmNet.state = (desktop == null) ? 'off' : 'connecting';
                rmmUpdateNet();
                if (desktop == null) { clearInterval(rmmTickTimer); rmmTickTimer = null; }
                return;
            }
            if ((now - rmmNet.rateAt) >= 2000) {
                var dt = (now - rmmNet.rateAt) / 1000;
                rmmNet.rateBytes = rmmNet.bytes / dt; rmmNet.rateTiles = rmmNet.tiles / dt;
                rmmNet.bytes = 0; rmmNet.tiles = 0; rmmNet.rateAt = now;
            }
            if ((window.devicePixelRatio || 1) != rmmLastDpr) { rmmLastDpr = (window.devicePixelRatio || 1); rmmOnWindowResize(); } // not every browser fires an event for this
            var m = desktop.m;
            rmmNet.decodeQueue = Math.max(0, (m.tilesReceived || 0) - (m.TilesDrawn || 0));
            var outstanding = (rmmNet.lastProbe > rmmNet.lastReply) ? (now - rmmNet.lastProbe) : 0;
            var rtt = rmmRecentRtt(now), base = rmmBaseRtt(now);
            var eff = Math.max((rtt == null) ? 0 : rtt, outstanding);
            rmmNet.eff = ((rtt == null) && (outstanding == 0)) ? null : eff;
            rmmNet.base = base;
            // Step 2: on the direct path the delay the user feels is the direct round trip plus any queue
            // the relay probe sees (on a phone the bottleneck is usually the phone's own link, shared by both).
            if ((rmmNet.eff != null) && (rmmRtc.state == 'direct') && (rmmRtc.rtt != null)) {
                eff = rmmRtc.rtt + Math.max(0, eff - ((base == null) ? eff : base));
                rmmNet.eff = eff;
            }

            // Dead link: the probe is unanswered and nothing at all has arrived for 12 s.
            if ((outstanding > RMM_DEAD_MS) && ((now - rmmNet.lastData) > RMM_DEAD_MS)) { rmmForceReconnect(); return; }
            // Step 2: after a network change (wifi <-> mobile data, screen back on) a dead link is found in ~3 s.
            if (rmmNet.checkUntil && (now > rmmNet.checkUntil)) {
                var since = rmmNet.checkFrom;
                rmmNet.checkUntil = 0;
                if ((rmmNet.lastReply < since) && (rmmNet.lastData < since)) { rmmForceReconnect(); return; }
            }
            // Step 2: a stall (nothing arrives at all, typical for a phone changing cell or network) is a
            // dropout, not a full link. It does not lower the quality; the first seconds after it are ignored.
            var stalled = (outstanding > 1500) && ((now - rmmNet.lastData) > 1000);
            if (stalled) { rmmNet.stallEnd = now + 4000; rmmNet.stallProbe = rmmNet.lastProbe; }

            var state;
            if (rmmNet.eff == null) { state = ((now - rmmNet.connectedAt) < 4000) ? 'measuring' : 'good'; }
            else if ((eff > 400) || (rmmNet.decodeQueue > 40)) { state = 'bad'; }
            else if ((eff > 150) || (rmmNet.decodeQueue > 12)) { state = 'shaky'; }
            else { state = 'good'; }
            rmmNet.state = state;

            if ((rmmPrefs.quality == 'auto') && !stalled && !(rmmNet.stallEnd && (now < rmmNet.stallEnd)) && !(rmmNet.settleUntil && (now < rmmNet.settleUntil))) { rmmAutoAdjust(now, eff, base, outstanding); }
            else if (stalled) { rmmNet.badTicks = 0; rmmNet.shakyTicks = 0; rmmNet.goodSince = 0; }
            if ((rmmRtc.state == 'direct') && ((now - rmmRtc.statsAt) >= 2000)) { rmmRtcStats(); }
            rmmUpdateNet();
        }

        // Auto: step down when the delay grows above the line's own normal delay (a queue is building)
        // or the browser falls behind drawing; step up after 10 s of good values.
        function rmmAutoAdjust(now, eff, base, outstanding) {
            if (rmmNet.eff == null) return;
            var queue = Math.max(0, eff - ((base == null) ? 0 : base));
            if ((rmmRtc.state == 'direct') && (rmmRtc.rtt != null)) { queue = Math.max(0, eff - rmmRtc.rtt); } // eff already holds direct rtt + queue
            var bad = (queue > 300) || (outstanding > 2000) || (rmmNet.decodeQueue > 40);
            var shaky = bad || (queue > 120) || (rmmNet.decodeQueue > 12);
            var good = !shaky && (queue < 60) && (rmmNet.decodeQueue <= 4);
            if (bad) { rmmNet.badTicks++; } else { rmmNet.badTicks = 0; }
            if (shaky) { rmmNet.shakyTicks++; } else { rmmNet.shakyTicks = 0; }
            if (good) { if (!rmmNet.goodSince) { rmmNet.goodSince = now; } } else { rmmNet.goodSince = 0; }
            if ((rmmAutoStep < RMM_LADDER.length - 1) && ((now - rmmNet.lastDown) > 4000) && ((rmmNet.badTicks >= 2) || (rmmNet.shakyTicks >= 4))) {
                rmmAutoStep++;
                rmmNet.lastDown = now; rmmNet.badTicks = 0; rmmNet.shakyTicks = 0; rmmNet.goodSince = 0;
                rmmApplyProfile('auto-down');
                return;
            }
            if ((rmmAutoStep > rmmAutoBestStep()) && rmmNet.goodSince && ((now - rmmNet.goodSince) >= 10000) && ((now - rmmNet.lastDown) >= 15000)) {
                rmmAutoStep--;
                rmmNet.goodSince = now;
                rmmApplyProfile('auto-up');
            }
        }

        function rmmForceReconnect() {
            if (desktop == null) return;
            rmmNet.lastProbe = 0; rmmNet.lastReply = 0;
            try { desktop.Stop(); } catch (ex) { } // state 0 -> onDesktopStateChange -> reconnect with back-off
        }

        function rmmInfoText() {
            var s = rmmLastSent;
            if (s == null) return 'Ingen bild än.';
            var fmt = (rmmAgentFormat == 'png') ? 'PNG' : ((rmmAgentFormat == 'webp') ? 'WebP' : 'JPEG'); // what the tiles really are
            var x = fmt + ', kvalitet ' + s.q + ', högst ' + Math.round(1000 / s.fr) + ' bilder/s, skala ' + Math.round(rmmAgentScaling / 10.24) + ' %';
            if (rmmPendingScaling != null) { x += ' (väntar på ' + Math.round(rmmPendingScaling / 10.24) + ' %)'; }
            else if (Date.now() < rmmScale.ignoredUntil) { x += ' (datorn skalar inte, provar igen om en stund)'; }
            x += ', ' + Math.round(rmmNet.rateBytes / 1024) + ' kB/s';
            if (rmmPrefs.quality == 'auto') { x += ', Auto steg ' + (rmmAutoStep + 1) + ' av ' + RMM_LADDER.length; }
            x += ', ' + rmmPathText(true);
            return x;
        }

        function rmmUpdateNet() {
            var el = Q('rmmNet');
            if (!el) return;
            var cls = 'rmm-net', text = 'Ingen kontakt', ms = '';
            switch (rmmNet.state) {
                case 'good': cls += ' rmm-net-good'; text = 'Bra'; break;
                case 'shaky': cls += ' rmm-net-shaky'; text = 'Svajig'; break;
                case 'bad': cls += ' rmm-net-bad'; text = 'Dålig'; break;
                case 'measuring': text = 'Mäter…'; break;
                case 'connecting': text = 'Ansluter'; break;
            }
            if ((rmmNet.eff != null) && ((rmmNet.state == 'good') || (rmmNet.state == 'shaky') || (rmmNet.state == 'bad'))) { ms = Math.round(rmmNet.eff) + ' ms'; }
            var path = ((rmmNet.state == 'off') || (rmmNet.state == 'connecting')) ? '' : rmmPathText(false);
            var els = [['rmmNet', 'rmmNetText', 'rmmNetMs', 'rmmNetPath'], ['rmmMNet', 'rmmMNetText', 'rmmMNetMs', 'rmmMNetPath']];
            for (var i = 0; i < els.length; i++) {
                var e = Q(els[i][0]);
                if (!e) continue;
                if (e.className != cls) { e.className = cls; }
                if (Q(els[i][1]).textContent != text) { Q(els[i][1]).textContent = text; }
                if (Q(els[i][2]).textContent != ms) { Q(els[i][2]).textContent = ms; }
                if (Q(els[i][3]).textContent != path) { Q(els[i][3]).textContent = path; }
                e.setAttribute('data-state', rmmNet.state);
            }
            el.title = 'Anslutningen: ' + text + (ms ? (', ' + ms) : '') + '. ' + rmmInfoText();
            var h = Q('rmmHandle');
            if (h) {
                h.setAttribute('data-state', rmmNet.state);
                var ht = (rmmReconnectShown() && !rmmQuietNow()) ? 'Ansluter igen' : text;
                if (Q('rmmHandleText').textContent != ht) { Q('rmmHandleText').textContent = ht; }
                h.setAttribute('aria-label', 'Visa knapparna. Anslutningen: ' + text + (ms ? (', ' + ms) : '') + (path ? (', ' + path) : ''));
            }
        }

        function rmmUpdateUi() {
            var i, b = document.querySelectorAll('#rmmQuality .rmm-btn, #rmmPanel [data-q]');
            for (i = 0; i < b.length; i++) { b[i].setAttribute('aria-pressed', (b[i].getAttribute('data-q') == rmmPrefs.quality) ? 'true' : 'false'); }
            b = document.querySelectorAll('#rmmFit .rmm-btn');
            for (i = 0; i < b.length; i++) { b[i].setAttribute('aria-pressed', ((b[i].getAttribute('data-fit') == '1') == rmmPrefs.fit) ? 'true' : 'false'); }
            if (Q('rmmMacButton')) { Q('rmmMacButton').setAttribute('aria-pressed', rmmMacKeysOn() ? 'true' : 'false'); }
            if (Q('rmmFullButton')) { var fs = isBrowserFullscreen() ? 'Lämna helskärm' : 'Helskärm'; Q('rmmFullButton').title = fs; Q('rmmFullButton').setAttribute('aria-label', fs); }
            if (Q('deskstatus') && (expire != '')) { Q('deskstatus').title = printFlexDateTime(new Date(parseInt(expire))); }
            if (Q('d7rmmInfo') && xxdialogMode == 7) { QH('d7rmmInfo', EscapeHtml(rmmInfoText())); }
            rmm2UpdateUi();
        }


        //
        // Nordbase Remote step 2 (2026-11-15)
        // Phones and tablets: the remote screen fills the phone, the controls sit behind one small handle,
        // two pointer modes (Styrplatta = relative like a laptop trackpad, Peka = tap where you click),
        // pinch zoom and pan, the phone keyboard with a key bar and sticky Ctrl/Alt/Win, and smaller
        // pictures (never a 4K frame to a phone). The direct path (WebRTC) is used when the server allows
        // it and falls back to the relay without a sound. A phone that changes network finds a dead link in
        // about 3 s. Nothing here opens a new channel to the server: WebRTC is negotiated inside the share's
        // own desktop relay and closes with it (stop, share expiry, share removed). The clipboard rules of
        // security review part 2 are untouched.
        //

        var RMM_TAP_MOVE = 10;          // px a finger may move and still be a tap
        var RMM_HOLD_MS = 450;          // press and hold
        var RMM_DBL_MS = 300;           // a second tap within this time is a double tap
        var RMM_SMALL_SCALE = 0.6;      // screen px per remote px below which a double tap zooms in
        var RMM_ZOOM_TARGET = 0.9;      // a double tap zooms to about this many screen px per remote px
        var RMM_MAX_SCALE = 3;          // most zoom: 3 screen px per remote px
        var RMM_PIXEL_CAP = { phone: 1920 * 1080, tablet: 2560 * 1600 }; // most pixels per frame to a phone / tablet
        var RMM_WHEEL_PER_PX = 1.2;     // wheel units per remote pixel scrolled (120 = one notch, about 100 px in a browser)
        var RMM_WHEEL_QUANTUM = (remotePlatform == 'windows') ? 30 : 120; // Windows takes part notches; others get whole ones
        var RMM_RTC_TIMEOUT = 12000;    // no direct path by then: stay on the relay
        var RMM_RTC_COOL_FAIL = 600000; // after a failed try: 10 min before the next one
        var RMM_RTC_COOL_LOST = 120000; // after the direct path broke: 2 min on the relay
        var RMM_IME_SENTINEL = '  '; // kept in the hidden field so Backspace always has something to delete
