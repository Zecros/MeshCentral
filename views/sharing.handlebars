    <script>
        var random = '{{{randomlength}}}' // Random length string for BREACH mitigation
        var sessionActivity = null;
        var desktop = null;
        var agentPresent = true;
        var intelAmtPresent = false;
        var deskAspectRatio = 0;
        var desktopsettings = { encoding: 2, showfocus: false, showmouse: true, showcad: true, quality: 40, scaling: 1024, framerate: 50, localkeymap: false, remotekeymap: false };
        var serverPublicNamePort = '{{{serverDnsName}}}:{{{serverPublicPort}}}';
        var domain = '{{{domain}}}';
        var domainUrl = '{{{domainurl}}}';
        var authCookie = '{{{authCookie}}}';
        var viewOnly = parseInt('{{{viewOnly}}}');
        var urlargs = parseUriArgs();
        var debugmode = urlargs.debug;
        var attemptWebRTC = false;
        var updateSessionTimer = null;
        var shareControl = null;
        var shareControlReady = false;
        var shareControlReconnectTimer = null;
        // Clipboard (Nordbase, security review part 2): never automatic. Text moves only when the
        // operator presses "Pull from device" or "Push to device", only in the window that has focus,
        // and the channel is only open while the desktop session is connected and the share is valid.
        var clipboardManualGetPending = false;
        var clipboardManualGetTimer = null;
        var shareExpiryTimer = null;
        var clipboardStatus = 'Urklippet flyttas bara när du trycker Hämta eller Skicka.';
        var rmmDesktopReconnectTimer = null;
        var rmmDesktopConnectWatchdogTimer = null;
        var rmmDesktopReconnectEnabled = true;
        var StatusStrs = ["Väntar", "Ansluter", "Förbereder", "Ansluten", "Ansluten (hårdvara)"];
        var nodeName = decodeURIComponent('{{{nodeName}}}');
        var remotePlatform = '{{{remotePlatform}}}';
        var webPageFullScreen = false;
        var expire = '{{{expire}}}';
        if (expire != '') {
            QH('p11power', printFlexDateTime(new Date(parseInt(expire))));
            QH('p12power', printFlexDateTime(new Date(parseInt(expire))));
            QH('p13power', printFlexDateTime(new Date(parseInt(expire))));
        }
        var features = parseInt('{{{features}}}');
        var features2 = parseInt('{{{features2}}}');
        var features3 = parseInt('{{{features3}}}');

        // Load desktop settings
        var t = null;
        try { t = localStorage.getItem('desktopsettings'); } catch (ex) { }
        if (t != null) { try { desktopsettings = JSON.parse(t); } catch (ex) { } }
        if (((features2 & 1) == 0) && (desktopsettings.quality > 60)) { desktopsettings.quality = 60; }

        // Terminal
        var terminal = null;
        var xterm = null;
        var xtermfit = null;
        var xtermimage = null;
        var xtermResizeTimer = null;

        // Files
        var files = null

        // Console messages timers
        var p11DeskConsoleMsgTimer = null;
        var p12TermConsoleMsgTimer = null;
        var p13FilesConsoleMsgTimer = null;

        function start() {
            document.body.classList.add('rmm-remote');
            window.onresize = deskAdjust;
            document.onkeypress = ondockeypress;
            document.onkeydown = ondockeydown;
            document.onkeyup = ondockeyup;
            window.addEventListener('beforeunload', stopRmmRemoteRuntime);
            setupDesktop();
            setupTerminal();
            setupFiles();
            scheduleShareExpiryClose();

            // Set the file editor
            d4EditWrapVal = Number(getstore('editorWrap', 0));
            d4EditSizeVal = Number(getstore('editorSize', 0));
            d4EditEncodingVal = Number(getstore('editorEncoding', 0));
            d4EditLineBreakVal = Number(getstore('editorLineBreak', 0));
            d4ToggleWrap(true);
            d4ToggleSize(true);
            d4ToggleEncoding(true);
            d4ToggleLineBreak(true);

            // Set the document title
            if (nodeName.length > 0) {
                document.title = 'Nordbase Remote - ' + nodeName;
                QH('rmmRemoteDevice', EscapeHtml(nodeName));
            }

            // View only mode
            if (viewOnly == 1) {
                QV('deskkeys', false);
                QV('DeskWD', false);
                QV('DeskClip', false);
                QV('DeskType', false);
                QV('DeskControlSpan', false);
            }

            // Setup upload drag & drop
            Q('p13filetable').addEventListener('drop', p13fileDragDrop, false);
            Q('p13filetable').addEventListener('dragover', p13fileDragOver, false);
            Q('p13filetable').addEventListener('dragleave', p13fileDragLeave, false);

            // Setup feature visibility
            QV('LeftMenuDesktop', features & 2);
            QV('LeftMenuTerminal', features & 1);
            QV('LeftMenuFiles', features & 4);
            if (features & 2) { go(11); } // Goto desktop
            else if (features & 1) { go(12); } // Goto terminal
            else if (features & 4) { go(13); } // Goto files

            // Only show left bar if two or more features are visible
            var featureCount = 0;
            if (features & 1) { featureCount++; }
            if (features & 2) { featureCount++; }
            if (features & 4) { featureCount++; }
            QV('LeftSideToolBar', featureCount > 1);
            QS('p11')['left'] = (featureCount > 1) ? '54px' : '0px';
            QS('p12')['left'] = (featureCount > 1) ? '54px' : '0px';
            QS('p13')['left'] = (featureCount > 1) ? '54px' : '0px';

            rmmInit();
            deskAdjust();
            setTimeout(rmmRemoteAutoConnect, 250);
        }

        function rmmRemoteAutoConnect() {
            if ((features & 2) && (desktop == null)) { connectDesktop(null, 1); return; }
            if ((features & 1) && (terminal == null)) { connectTerminal(null, 1); return; }
            if ((features & 4) && (files == null)) { connectFiles(null); }
        }

        function shareIsExpired() { return (expire != '') && (parseInt(expire) <= Date.now()); }

        function setupShareControl() {
            // Only for a connected desktop session of a share that has not expired.
            if (((features & 2) == 0) || shareIsExpired() || (desktop == null) || (desktop.State != 3)) return;
            if ((shareControl != null) && ((shareControl.readyState == 0) || (shareControl.readyState == 1))) return;
            var protocol = (window.location.protocol == 'https:') ? 'wss://' : 'ws://';
            try {
                shareControl = new WebSocket(protocol + window.location.host + domainUrl + 'sharecontrol.ashx?auth=' + encodeURIComponent(authCookie));
            } catch (ex) { scheduleShareControlReconnect(); return; }
            shareControl.onopen = function () { shareControlReady = false; updateDesktopButtons(); };
            shareControl.onmessage = function (event) {
                var message = null;
                try { message = JSON.parse(event.data); } catch (ex) { return; }
                if ((message.action == 'sharecontrol') && (message.status == 'ready')) {
                    shareControlReady = (message.clipboard === true);
                    updateDesktopButtons();
                    return;
                }
                if (message.action == 'close') { closeShareControl(); updateClipboardStatus('Urklippet är stängt (' + String(message.cause || 'stängt').substring(0, 40) + ')'); return; }
                if ((message.action == 'clipboard') && (message.status == 'offline')) { updateClipboardStatus('Datorn är inte ansluten.'); return; }
                if ((message.action == 'clipboard') && (message.status == 'throttled')) { updateClipboardStatus('Urklippet är upptaget. Tryck igen om en stund.'); return; }
                if ((message.type == 'getclip') && (typeof message.data == 'string')) {
                    // Only an answer to the operator's own "Pull from device" is used; anything else is ignored.
                    if (!NordbaseClipboard.acceptRemoteClipboard({ manualGetPending: clipboardManualGetPending })) return;
                    clearManualGet();
                    if (Q('d2clipText')) { Q('d2clipText').value = message.data; }
                    writeLocalClipboardText(message.data);
                } else if (message.type == 'setclip') {
                    updateClipboardStatus(message.success === true ? 'Skickat till datorns urklipp' : 'Det gick inte att skicka');
                }
            };
            shareControl.onclose = function () {
                shareControl = null;
                shareControlReady = false;
                clearManualGet();
                updateDesktopButtons();
                scheduleShareControlReconnect();
            };
            shareControl.onerror = function () { shareControlReady = false; };
        }

        function scheduleShareControlReconnect() {
            if ((shareControlReconnectTimer != null) || shareIsExpired() || (desktop == null) || (desktop.State != 3)) return;
            shareControlReconnectTimer = setTimeout(function () { shareControlReconnectTimer = null; setupShareControl(); }, 2500);
        }

        function closeShareControl() {
            if (shareControlReconnectTimer != null) { clearTimeout(shareControlReconnectTimer); shareControlReconnectTimer = null; }
            clearManualGet();
            shareControlReady = false;
            if (shareControl != null) {
                shareControl.onclose = null;
                try { shareControl.close(); } catch (ex) { }
                shareControl = null;
            }
            updateDesktopButtons();
        }

        // When the share link expires, the clipboard channel closes (the server closes it too).
        function scheduleShareExpiryClose() {
            if (shareExpiryTimer != null) { clearTimeout(shareExpiryTimer); shareExpiryTimer = null; }
            if (expire == '') return;
            var left = parseInt(expire) - Date.now();
            if (left <= 0) { closeShareControl(); rmmOnShareExpired(); return; }
            shareExpiryTimer = setTimeout(scheduleShareExpiryClose, Math.min(left, 0x7FFFFFFF));
        }

        function clearManualGet() {
            clipboardManualGetPending = false;
            if (clipboardManualGetTimer != null) { clearTimeout(clipboardManualGetTimer); clipboardManualGetTimer = null; }
        }

        function clipboardActionAllowed() {
            return NordbaseClipboard.manualClipboardAllowed({
                hasFocus: (typeof document.hasFocus == 'function') ? document.hasFocus() : false,
                hidden: document.hidden === true,
                expired: shareIsExpired(),
                desktopConnected: (desktop != null) && (desktop.State == 3),
                channelReady: shareControlReady && (shareControl != null) && (shareControl.readyState == 1)
            });
        }

        function sendShareClipboard(operation, data) {
            if (!clipboardActionAllowed()) { updateClipboardStatus('Urklippet fungerar bara i fönstret du använder, när datorn är ansluten.'); return false; }
            var message = { action: 'clipboard', operation: operation };
            if (operation == 'set') {
                if (viewOnly == 1) return false;
                message.data = String(data || '').substring(0, 65535);
            }
            shareControl.send(JSON.stringify(message));
            return true;
        }

        function updateClipboardStatus(value) {
            clipboardStatus = value;
            if (Q('dlgClipStatus')) { QH('dlgClipStatus', EscapeHtml(value)); }
            if (Q('DeskClip')) { Q('DeskClip').title = value; }
        }

        function writeLocalClipboardText(text) {
            function clipboardWriteSucceeded() {
                updateClipboardStatus('Kopierat till ditt urklipp');
            }
            function clipboardWriteFallback() {
                updateClipboardStatus('Hämtat. Webbläsaren stoppade kopieringen, kopiera texten från rutan.');
            }
            if ((navigator.clipboard != null) && (navigator.clipboard.writeText != null)) {
                navigator.clipboard.writeText(text).then(clipboardWriteSucceeded).catch(clipboardWriteFallback);
            } else {
                clipboardWriteFallback();
            }
        }

        function stopRmmRemoteRuntime() {
            rmmDesktopReconnectEnabled = false;
            rmmStopTimers();
            if (shareExpiryTimer != null) { clearTimeout(shareExpiryTimer); shareExpiryTimer = null; }
            if (rmmDesktopReconnectTimer != null) { clearTimeout(rmmDesktopReconnectTimer); rmmDesktopReconnectTimer = null; }
            if (rmmDesktopConnectWatchdogTimer != null) { clearTimeout(rmmDesktopConnectWatchdogTimer); rmmDesktopConnectWatchdogTimer = null; }
            closeShareControl();
        }

        function scheduleDesktopReconnect() {
            if (!rmmDesktopReconnectEnabled || (rmmDesktopReconnectTimer != null) || shareIsExpired() || ((features & 2) == 0)) return;
            // Back-off: 0.5 s, 1 s, 2 s, then every 5 s, until the share expires (Nordbase step 1).
            var delay = RMM_RECONNECT_STEPS[Math.min(rmmReconnectAttempt, RMM_RECONNECT_STEPS.length - 1)];
            rmmReconnectAttempt++;
            rmmShowReconnect('retry', delay);
            rmmDesktopReconnectTimer = setTimeout(function () {
                rmmDesktopReconnectTimer = null;
                if ((desktop == null) && rmmDesktopReconnectEnabled && !shareIsExpired()) { connectDesktop(null, 1); }
            }, delay);
        }

        function armDesktopConnectWatchdog() {
            if (rmmDesktopConnectWatchdogTimer != null) { clearTimeout(rmmDesktopConnectWatchdogTimer); }
            rmmDesktopConnectWatchdogTimer = setTimeout(function () {
                rmmDesktopConnectWatchdogTimer = null;
                if ((desktop == null) || (desktop.State == 3) || !rmmDesktopReconnectEnabled || shareIsExpired()) return;
                var stalledDesktop = desktop;
                desktop = null;
                stalledDesktop.onStateChanged = null;
                try { stalledDesktop.Stop(); } catch (ex) { }
                QH('deskstatus', 'Ansluter igen');
                updateDesktopButtons();
                scheduleDesktopReconnect();
            }, 10000);
        }


